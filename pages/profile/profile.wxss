/* pages/profile/profile.wxss */
page {
  background-color: #F7F8FA;
}

.container {
  padding: 0;
  display: flex;
  flex-direction: column;
}

/* 头部 */
.header-section {
  display: flex;
  align-items: center;
  padding: 140rpx 40rpx 80rpx 40rpx; /* 顶部增加100rpx以适配自定义导航栏 */
  background-color: #FFEAEB; /* 浅粉色背景 */
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  background-color: #eee;
}

.info-box {
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.uid {
  font-size: 24rpx;
  color: #999;
}

/* 资产卡片 */
.asset-card {
  margin: -60rpx 30rpx 30rpx 30rpx; /* 向上重叠 */
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.asset-info {
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.value-row {
  display: flex;
  align-items: center;
}

.egg-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.count {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.recharge-btn {
  margin: 0;
  background: linear-gradient(90deg, #FF9A9E 0%, #FECFEF 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 40rpx;
  border-radius: 30rpx;
  line-height: normal;
}
.recharge-btn::after { border: none; }

/* 菜单列表 */
.menu-list {
  margin: 0 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 30rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
}

.item-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
  border-radius: 8rpx;
}

.item-text {
  font-size: 30rpx;
  color: #333;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

.version-text {
  font-size: 26rpx;
  color: #ccc;
}
