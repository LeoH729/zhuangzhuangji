.container {
  min-height: 100vh;
  background: var(--color-bg);
}
.user-header {
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx;
  background: var(--color-card-bg);
}
.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-secondary);
  margin-right: 30rpx;
  box-shadow: var(--shadow-sm);
}
.avatar {
  width: 100%;
  height: 100%;
}
.user-info {
  flex: 1;
}
.nickname {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 12rpx;
}
.register-date {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-top: 6rpx;
}
.login-btn {
  background: none;
  padding: 0;
  margin: 0;
  text-align: left;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-main);
  line-height: 1.5;
}
.login-btn::after { border: none; }

.points-card {
  margin: 30rpx 40rpx;
  background: var(--color-primary);
  border-radius: var(--radius-md);
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
}
.pc-title {
  color: rgba(255,255,255,0.7);
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.pc-num {
  color: #fff;
  font-size: 56rpx;
  font-weight: bold;
}
.pc-btn {
  background: rgba(255,255,255,0.2);
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  backdrop-filter: blur(4px);
}

.star-task-card {
  margin: 0 32rpx 30rpx;
  padding: 38rpx 28rpx 32rpx;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: var(--shadow-sm);
}

.star-task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.star-task-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text-main);
  margin-bottom: 42rpx;
}

.star-task-progress {
  min-width: 76rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.star-task-progress.done {
  background: var(--color-secondary);
  color: var(--color-text-sub);
}

.star-task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 124rpx;
  padding: 24rpx 28rpx;
  margin-top: 26rpx;
  border-radius: 24rpx;
  background: #c7c1ff;
}

.star-task-row.done {
  background: #eeeeee;
  opacity: 1;
}

.star-task-copy {
  flex: 1;
  min-width: 0;
}

.star-task-main {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 18rpx;
  color: #050505;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.25;
}

.star-task-reward {
  white-space: nowrap;
}

.star-task-desc {
  margin-top: 16rpx;
  color: #747474;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
}

.star-task-action {
  flex-shrink: 0;
  min-width: 142rpx;
  height: 66rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #000000;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 66rpx;
  text-align: center;
}

.star-task-action.done {
  background: #d0d0d0;
  color: #ffffff;
}

.star-task-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-main);
  line-height: 1.5;
}

.star-task-row.done .star-task-text {
  color: var(--color-text-sub);
}

.star-task-row.done .star-task-main,
.star-task-row.done .star-task-desc {
  color: #b8b8b8;
}

.star-task-skeleton {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 124rpx;
  padding: 24rpx 28rpx;
  margin-top: 26rpx;
  border-radius: 24rpx;
  background: #f2f2f2;
  overflow: hidden;
}

.star-task-skeleton-copy {
  flex: 1;
  min-width: 0;
}

.star-task-skeleton-line,
.star-task-skeleton-action {
  background: linear-gradient(90deg, #e2e2e2 25%, #eeeeee 50%, #e2e2e2 75%);
  background-size: 220% 100%;
  animation: star-task-skeleton-shimmer 1.2s ease-in-out infinite;
}

.star-task-skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
}

.star-task-skeleton-main {
  width: 58%;
}

.star-task-skeleton-desc {
  width: 76%;
  height: 20rpx;
  margin-top: 18rpx;
}

.star-task-skeleton-action {
  flex-shrink: 0;
  width: 142rpx;
  height: 66rpx;
  border-radius: 999rpx;
}

.star-task-retry {
  min-height: 124rpx;
  margin-top: 26rpx;
  border-radius: 24rpx;
  background: #f2f2f2;
  color: #777777;
  font-size: 24rpx;
  line-height: 124rpx;
  text-align: center;
}

@keyframes star-task-skeleton-shimmer {
  from { background-position: 100% 0; }
  to { background-position: -120% 0; }
}

.menu-list {
  background: var(--color-card-bg);
  margin: 0 40rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 36rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: transparent;
  text-align: left;
  line-height: 1.5;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: var(--color-secondary);
}
.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}
.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-main);
}
.menu-arrow {
  color: var(--color-text-sub);
  font-family: monospace;
  font-size: 28rpx;
}
.contact-btn {
  border: none;
  margin: 0;
}
.contact-btn::after { border: none; }
