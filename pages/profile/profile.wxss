.container {
  min-height: 100vh;
  background: var(--color-bg);
}
.user-header {
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx;
  background: var(--color-card-bg);
}
.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-secondary);
  margin-right: 30rpx;
  box-shadow: var(--shadow-sm);
}
.avatar {
  width: 100%;
  height: 100%;
}
.user-info {
  flex: 1;
}
.nickname {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 12rpx;
}
.register-date {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-top: 6rpx;
}
.login-btn {
  background: none;
  padding: 0;
  margin: 0;
  text-align: left;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-main);
  line-height: 1.5;
}
.login-btn::after { border: none; }

.points-card {
  margin: 30rpx 40rpx;
  background: var(--color-primary);
  border-radius: var(--radius-md);
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
}
.pc-title {
  color: rgba(255,255,255,0.7);
  font-size: 26rpx;
  margin-bottom: 8rpx;
}
.pc-num {
  color: #fff;
  font-size: 56rpx;
  font-weight: bold;
}
.pc-btn {
  background: rgba(255,255,255,0.2);
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  backdrop-filter: blur(4px);
}

.menu-list {
  background: var(--color-card-bg);
  margin: 0 40rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 36rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: transparent;
  text-align: left;
  line-height: 1.5;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: var(--color-secondary);
}
.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}
.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-main);
}
.menu-arrow {
  color: var(--color-text-sub);
  font-family: monospace;
  font-size: 28rpx;
}
.contact-btn {
  border: none;
  margin: 0;
}
.contact-btn::after { border: none; }
