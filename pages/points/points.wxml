<view class="container pb-safe">
  <view wx:if="{{generationNotice.visible}}" class="generation-notice" bindtap="onGenerationNoticeTap">
    <view class="generation-notice-dot">✓</view>
    <text class="generation-notice-text">{{generationNotice.message}}</text>
    <text class="generation-notice-action">查看</text>
  </view>

  <!-- 当前余额 -->
  <view class="balance-card">
    <view class="balance-title">当前可用星光</view>
    <view class="balance-value">
      <text class="points-num">{{points}}</text>
    </view>
  </view>

  <!-- 充值套餐 -->
  <view class="section-title">获取星光</view>
  <view class="options-grid">
    <block wx:for="{{rechargeOptions}}" wx:key="id">
      <view class="option-item {{selectedOptionId === item.id ? 'active' : ''}}" bindtap="selectOption" data-id="{{item.id}}">
        <view class="option-amount">{{item.amount}} 星光</view>
        <view class="option-price">¥ {{item.price}}</view>
        <view class="option-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
      </view>
    </block>
  </view>

  <!-- 充值按钮 -->
  <view class="action-area">
    <button class="btn-primary {{isRecharging ? 'btn-disabled' : ''}}" hover-class="btn-hover" bindtap="onRecharge" disabled="{{isRecharging}}">
      {{isRecharging ? '处理中...' : '立即购买'}}
    </button>
  </view>

  <!-- 收支明细 -->
  <view class="section-title history-title">明细</view>
  <view class="history-list">
    <block wx:for="{{historyList}}" wx:key="_id">
      <view class="history-item">
        <view class="left">
          <text class="item-title">{{item.description || item.title || '消费'}}</text>
          <text class="item-time">{{item.time || item.createTime}}</text>
        </view>
        <view class="right {{item.type === 'recharge' || item.action === 'recharge' ? 'plus' : 'minus'}}">
          {{item.type === 'recharge' || item.action === 'recharge' ? '+' : '-'}}{{item.amount}}
        </view>
      </view>
    </block>
    <!-- 空状态 -->
    <view class="empty-view" wx:if="{{historyList.length === 0}}">暂无记录</view>
  </view>
</view>
