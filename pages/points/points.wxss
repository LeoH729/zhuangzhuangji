/* pages/points/points.wxss */
page {
  background-color: #FFF6F7;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.container {
  padding: 30rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
}

/* 余额卡片 */
.balance-card {
  background: linear-gradient(135deg, #FF9A9E 0%, #FECFEF 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  color: #fff;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 154, 158, 0.3);
}

.balance-label {
  font-size: 28rpx;
  opacity: 0.9;
}

.balance-value {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.egg-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 16rpx;
}

.points-num {
  font-size: 60rpx;
  font-weight: bold;
}

/* 标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}
.history-title {
  margin-top: 40rpx;
}

/* 充值套餐 */
.options-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.option-item {
  width: 30%; /* 三列布局 */
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  border: 2rpx solid transparent;
  position: relative;
  box-sizing: border-box;
}

.option-item.active {
  border-color: #FF9A9E;
  background-color: #FFE4E7;
}

.option-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.option-price {
  font-size: 24rpx;
  color: #999;
}
.option-item.active .option-price {
  color: #FF9A9E;
}

.option-tag {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: #FF5E62;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  transform: scale(0.9);
}

/* 充值按钮 */
.action-area {
  margin-top: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* .pay-btn 已替换为全局 .btn-primary */

.tips {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 16rpx;
}

/* 明细列表 */
.history-list {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 30rpx;
  margin-top: 10rpx;
  /* 确保 scroll-view 有高度 */
  height: 0; 
  min-height: 300rpx;
  box-sizing: border-box;
  width: 100%;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.history-item:last-child {
  border-bottom: none;
}

.left {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
  margin-right: 20rpx;
}

.item-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-time {
  font-size: 22rpx;
  color: #999;
}

.right {
  font-size: 32rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.plus { color: #FF9A9E; }
.minus { color: #333; }

.empty-view {
  padding: 50rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
