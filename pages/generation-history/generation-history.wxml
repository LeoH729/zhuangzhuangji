<view class="container pb-safe">
  <view wx:if="{{loading}}" class="loading-view">
    <view class="spinner"></view>
  </view>

  <view wx:if="{{!loading && taskList.length === 0}}" class="empty-view">暂无任务记录</view>

  <view class="task-list">
    <block wx:for="{{taskList}}" wx:key="id">
      <view class="task-card" bindtap="onCardTap" data-item="{{item}}">
        <view class="img-container {{item.status === 'succeeded' && !item.imageError && !item.image.loaded ? 'skeleton-shimmer skeleton-bg' : ''}}">
          <image wx:if="{{item.status === 'succeeded' && !item.imageError}}" class="task-img fade-in {{item.image.loaded ? 'visible' : ''}}" src="{{item.image.displayUrl}}" mode="aspectFill" lazy-load binderror="onImageError" bindload="onImageLoad" data-id="{{item.id}}"></image>
          <view wx:elif="{{item.status === 'pending' || item.status === 'running'}}" class="img-placeholder generating">
            <view class="spinner small-spinner"></view>
          </view>
          <view wx:else class="img-placeholder error">
            <icon type="warn" size="18" color="#999"></icon>
          </view>
        </view>

        <view class="task-info">
          <view class="task-header">
            <text class="feature-name">{{item.featureName}}</text>
            <view class="status-tag {{item.status}}">
              {{item.status === 'succeeded' ? '已完成' : (item.status === 'failed' ? '已失败' : '生成中')}}
            </view>
          </view>

          <text class="date-time">{{item.date}}</text>

          <view wx:if="{{item.status === 'failed' && item.errorMessage}}" class="error-wrapper">
            <text class="error-label">失败原因：</text>
            <text class="error-message">{{item.errorMessage}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{loadingMore}}" class="loading-more">加载中...</view>
  <view wx:if="{{!hasMore && taskList.length > 0}}" class="no-more">没有更多记录了</view>
</view>
