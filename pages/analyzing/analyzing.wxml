<view class="container full-page">
  <view class="generating-box">
    <view class="elegant-spinner"></view>
    <view class="loading-title">AI 正在绘制</view>
    <view class="loading-subtitle">{{statusText || '魔法正在发生，预计需要几十秒'}}</view>
    <view class="progress-bar">
      <view class="progress-inner" style="width: {{progress}}%"></view>
    </view>
    
    <!-- 提示与返回首页按钮 -->
    <view class="bottom-actions">
      <text class="hint-text">受不同大模型影响，生成时间可能需要1-5分钟</text>
      <button class="btn-outline" bindtap="goHome" hover-class="btn-hover">去逛逛其他</button>
    </view>
  </view>
</view>
