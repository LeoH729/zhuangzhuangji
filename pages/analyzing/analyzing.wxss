.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #FFF0F5; /* 改为柔和的粉色背景 */
  min-height: 100vh;
  padding-top: 100rpx;
}

.scan-container {
  position: relative;
  width: 480rpx;
  height: 640rpx;
  border-radius: 40rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 154, 158, 0.5); /* 边框颜色加深 */
  box-shadow: 0 0 40rpx rgba(255, 154, 158, 0.3);
  margin-bottom: 60rpx;
  background-color: #fff; /* 增加白色底防止镂空 */
}

.user-preview {
  width: 100%;
  height: 100%;
  filter: none; /* 移除灰度滤镜，保持原色，更符合生成中而非分析中的语境 */
}

.scan-bar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #FF9A9E, transparent);
  box-shadow: 0 0 20rpx #FF9A9E, 0 0 40rpx #FF9A9E;
  z-index: 5;
  animation: scanMove 3s linear infinite;
}

.scan-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, transparent, rgba(255, 154, 158, 0.1), transparent);
  z-index: 4;
  animation: scanMaskMove 3s linear infinite;
}

@keyframes scanMove {
  0% { top: 0; opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

@keyframes scanMaskMove {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(100%); }
}

.tip-text {
  margin-bottom: 80rpx;
  color: #FF7084; /* 更深一点的粉红色 */
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.carousel {
  position: relative;
  width: 100%;
  height: 144rpx;
  overflow: hidden;
}
.line {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  color: #E97885; /* 配合背景色的文字颜色 */
  font-size: 26rpx;
  opacity: 0.7;
  will-change: transform, opacity;
  transform: translate3d(0, 0, 0) scale(1);
  animation-name: scrollCycle;
  animation-duration: 8000ms;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  animation-fill-mode: both;
}
.paused .line { animation-play-state: paused; }
.play .line { animation-play-state: running; }

@keyframes scrollCycle {
  0%   { transform: translate3d(0, 144rpx, 0) scale(1);   opacity: 0; }
  20%  { transform: translate3d(0, 96rpx, 0)  scale(1);   opacity: .7; }
  40%  { transform: translate3d(0, 48rpx, 0)  scale(1.25);opacity: 1; }
  60%  { transform: translate3d(0, 0rpx, 0)   scale(1);   opacity: .7; }
  80%  { transform: translate3d(0, -48rpx,0)  scale(1);   opacity: 0; }
  100% { transform: translate3d(0, 144rpx, 0) scale(1);   opacity: 0; }
}

.l1 { animation-delay: 0ms; }
.l2 { animation-delay: -1600ms; }
.l3 { animation-delay: -3200ms; }
.l4 { animation-delay: -4800ms; }
.l5 { animation-delay: -6400ms; }