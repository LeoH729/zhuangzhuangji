.full-page {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: var(--color-bg);
}
.generating-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80%;
}
.elegant-spinner {
  width: 100rpx;
  height: 100rpx;
  border: 6rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  margin-bottom: 60rpx;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.loading-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 20rpx;
}
.loading-subtitle {
  font-size: 26rpx;
  color: var(--color-text-sub);
  margin-bottom: 60rpx;
}
.progress-bar {
  width: 100%;
  height: 8rpx;
  background: var(--color-border);
  border-radius: 4rpx;
  overflow: hidden;
}
.progress-inner {
  height: 100%;
  background: var(--color-primary);
  border-radius: 4rpx;
  transition: width 0.5s ease-out;
}
.bottom-actions {
  margin-top: 120rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hint-text {
  font-size: 24rpx;
  color: var(--color-text-sub);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.btn-outline {
  width: 100% !important;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--radius-xl);
  border: 2rpx solid #111111;
  background: #111111;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 0;
  margin: 0;
}
.btn-outline::after { border: none; }
