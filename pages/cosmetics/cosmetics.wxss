.container {
  padding: 20rpx;
  background-color: #FFF6F7;
  min-height: 100vh;
  position: relative;
}

/* 统计信息容器 */
.stats-container {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-radius: 48rpx;
  padding: 48rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.stat-item.warning .stat-number {
  color: #FAC384;
}

.stat-item.danger .stat-number {
  color: #F8ACB5;
}

/* 列表容器 */
.list-container {
  border-radius: 16rpx;
  min-height: calc(100vh - 200rpx);
  padding-bottom: 120rpx; /* 为悬浮按钮留出空间 */
}

/* 有数据时的列表容器样式 */
.list-container.has-data {
  background-color: transparent;
  box-shadow: none;
}

/* 空状态时的列表容器样式 */
.list-container.empty {
  background: transparent;
}

/* 用户授权界面 */
.auth-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 200rpx);
  background-color: #FFF6F7;
  border-radius: 16rpx;
}

.auth-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.auth-illustration {
  width: 464rpx;
  height: 684rpx;
  margin-bottom: 40rpx;
}

.auth-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.auth-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #2c2c2c;
  margin-bottom: 20rpx;
}

.auth-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.5;
}

.auth-btn {
  background: linear-gradient(135deg, #FF6B9D, #FF8E9B);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.3);
  transition: all 0.3s ease;
}

.auth-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.4);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 200rpx);
  background-color: #FFF6F7;
  border-radius: 16rpx;
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.app-title {
  font-size: 64rpx;
  font-weight: bold;
  color: #2c2c2c;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
}

.app-subtitle {
  font-size: 32rpx;
  color: #666;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 80rpx;
  white-space: pre-line;
}

.cosmetic-illustration {
  width: 464rpx;
  height: 684rpx;
  margin-bottom: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.illustration-img {
  width: 464rpx;
  height: 684rpx;
}

.add-cosmetic-btn {
  background: #F29AA1;
  color: #431317;
  width: 288rpx;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(242, 154, 161, 0.3);
  border: none;
  transition: all 0.3s ease;
}

.add-cosmetic-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(242, 154, 161, 0.4);
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
  font-weight: bold;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 悬浮加号按钮 */
.floating-add-btn {
  position: fixed;
  bottom: 120rpx;
  left: 40rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  opacity: 1;
  transform: scale(1) translateY(0);
  transition: all 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
}

.floating-add-btn:active {
  transform: scale(0.95) translateY(0);
}

.floating-add-icon {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* 编辑弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 999;
}

.modal-container {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  padding: 48rpx 48rpx 48rpx 48rpx;
  z-index: 1000;
  max-height: 85vh;
  overflow-y: auto;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 0 24rpx 0;
  margin-bottom: 24rpx;
  border-bottom: none;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  background-color: #f8f8f8;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close::before, .modal-close::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 2rpx;
  background-color: #666;
  border-radius: 1rpx;
}

.modal-close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.modal-close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.modal-content {
  padding: 0 0 32rpx 0;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0 0 0;
  border-top: none;
}

.cancel-btn {
  flex: 1;
  background-color: #333333;
  color: #ffffff;
  border-radius: 80rpx;
  font-size: 32rpx;
  font-weight: 400;
  height: 96rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.save-btn {
  flex: 1;
  background-color: #f8acb5;
  color: #333333;
  border-radius: 80rpx;
  font-size: 32rpx;
  font-weight: 400;
  height: 96rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: none;
}

/* 表单样式 */
.upload-container {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  display: block;
  font-weight: 500;
}

.upload-area {
  width: 100%;
  height: 320rpx;
  background-color: #fafafa;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 2rpx dashed #e0e0e0;
  box-sizing: border-box;
}

.uploaded-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 32rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.camera-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
  opacity: 0.5;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.upload-tips {
  font-size: 20rpx;
  color: #ccc;
  margin-top: 10rpx;
}

.form-container {
  padding: 0;
  box-sizing: border-box;
}

.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  padding: 0;
  box-sizing: border-box;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
}

.form-label {
  font-size: 30rpx;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.char-count {
  font-size: 26rpx;
  color: #999999;
}

.form-label.required::after {
  content: '*';
  color: #ff8a65;
  margin-left: 8rpx;
  font-size: 32rpx;
}

.input-container {
  width: 100%;
  position: relative;
  cursor: pointer;
  padding: 0;
  box-sizing: border-box;
}

.form-input,
.form-picker,
.form-textarea {
  width: 100%;
  height: 96rpx;
  border: none;
  border-radius: 24rpx;
  padding: 32rpx 48rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background-color: #eeeeee;
  transition: all 0.3s ease;
}

.form-input:focus,
.form-picker:focus {
  background-color: #eeeeee;
  box-shadow: none;
}

.form-picker {
  z-index: 10;
  position: relative;
  width: 100%;
  box-sizing: border-box;
}

.picker-text {
  width: 100%;
  height: 100%;
  display: block;
}

/* 设置placeholder的颜色 */
.form-input::placeholder,
.form-textarea::placeholder {
  color: #999999;
  font-size: 30rpx;
}

/* 未选择状态的文本颜色 */
.placeholder-style {
  color: #999999;
  font-size: 30rpx;
}

.picker-text {
  line-height: 32rpx;
  color: #333333;
  pointer-events: none;
  font-size: 30rpx;
}

.form-textarea {
  width: 100%;
  margin: 0;
  height: 120rpx;
  border: none;
  border-radius: 24rpx;
  padding: 32rpx 48rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background-color: #eeeeee;
  transition: all 0.3s ease;
  line-height: 1.5;
}

.form-textarea:focus {
  background-color: #eeeeee;
  box-shadow: none;
}

.date-tip {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
  display: block;
}

/* 化妆品列表 */
.cosmetic-list {
  padding: 20rpx 0;
}

.cosmetic-item {
  display: flex;
  flex-direction: row;
  padding: 32rpx 32rpx 32rpx 32rpx;
  margin-bottom: 32rpx;
  background-color: #FFF;
  border-radius: 48rpx;
}

.cosmetic-item.expanded {
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx;
}

.cosmetic-item.expanded .item-img-container {
  width: 140rpx;
  height: 140rpx;
  margin-right: 30rpx;
  margin-bottom: 0;
}

.item-details {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
  align-self: stretch;
  width: 100%;
}

.detail-item {
  display: flex;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #666;
}

.detail-item.notes {
  flex-direction: column;
}

.detail-label {
  width: 120rpx;
  color: #666666;
  font-size: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.detail-value {
  flex: 1;
  color: #666666;
  font-size: 24rpx;
}

.item-days-left.today-expired {
  color: #ff7d00;
}

.edit-btn {
  background-color: #f5f5f5;
  color: #007aff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.item-left {
  width: 240rpx;
  margin-right: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.item-right {
  flex: 1 0 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.item-img-container {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: #f0f0f0;
  margin-bottom: 16rpx;
}

.item-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.status-badge {
  position: absolute;
  top: 0;
  left: 0;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: white;
  border-radius: 0 0 16rpx 0;
}

.status-badge.warning {
  background-color: #FAC384;
  color: #333;
}

.status-badge.today-expired {
  background-color: #F8ACB5;
  color: #333333;
}

.status-badge.expired {
  background-color: #F8ACB5;
}

.item-info {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  align-self: stretch;
}

/* 产品名称容器 */
.item-name-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  width: 100%;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  margin-right: 16rpx;
}

/* 提醒铃铛图标 */
.reminder-bell-icon {
  width: 114rpx;
  height: 60rpx;
  flex-shrink: 0;
}

.item-category {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 6rpx;
}

.item-expiry {
  font-size: 28rpx;
  color: #666;
}

.item-days-left {
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  margin-top: 8rpx;
  color: #FAC384;
}

.item-days-left.warning {
  color: #ff9500;
}

.item-days-left.danger {
  color: #F8ACB5;
}

.item-days-left.today-expired {
  color: #F8ACB5;
}

.item-details {
  flex: 1;
}

.item-actions {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  align-self: flex-end;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
}

.edit-icon {
  margin-right: 24rpx;
}

.delete-btn {
  background-color: #fff;
  color: #ff3b30;
  padding: 16rpx 32rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  border: 2rpx solid #ff3b30;
  line-height: 1.5;
}

/* 下拉刷新样式 */
.refresh-trigger {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.refresh-text {
  font-size: 24rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

/* 提醒弹窗样式 */
.reminder-modal {
  /* 继承基础modal样式 */
}

.reminder-info {
  text-align: center;
  padding: 20rpx 0;
}

.cosmetic-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.expiry-info {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.reminder-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.confirm-btn {
  flex: 1;
  background-color: #f8acb5;
  color: #333333;
  border-radius: 80rpx;
  font-size: 32rpx;
  font-weight: 400;
  height: 96rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}