/* 编辑化妆品页面样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 区域标题 */
.section-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
  font-weight: 500;
}

/* 图片上传区域 */
.upload-container {
  margin-bottom: 30rpx;
}

.upload-area {
  width: 100%;
  height: auto;
  background-color: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 48rpx 143rpx 54rpx;
  box-sizing: border-box;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 464rpx;
  height: 464rpx;
  aspect-ratio: 1/1;
}

.camera-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 15rpx;
  opacity: 0.5;
}

.upload-text {
  font-size: 28rpx;
  color: #999;
}

.uploaded-img {
  width: 464rpx;
  height: 464rpx;
  border-radius: 16rpx;
  object-fit: cover;
  display: block;
  background-color: #f0f0f0;
  aspect-ratio: 1/1;
}

.upload-tips {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 16rpx;
}

/* 表单容器 */
.form-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 表单项目 */
.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 25rpx;
}

.form-label-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.form-label {
  font-size: 30rpx;
  color: #333;
  display: flex;
  align-items: center;
  font-weight: 500;
}

.char-count {
  font-size: 24rpx;
  color: #999999;
}

.required {
  position: relative;
}

.required::before {
  content: '*';
  color: #ff3b30;
  margin-right: 5rpx;
}

.input-container {
  width: 100%;
  position: relative;
  cursor: pointer;
  padding: 16rpx 16rpx 0;
  box-sizing: border-box;
}

.form-input,
.form-picker,
.form-textarea {
  width: 100%;
  padding: 15rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 10rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.form-picker {
  z-index: 10;
  position: relative;
  width: 100%;
  box-sizing: border-box;
}

.picker-text {
  width: 100%;
  height: 100%;
  display: block;
}

/* 设置placeholder的颜色 */
.form-input::placeholder,
.form-textarea::placeholder {
  color: #999999;
}

/* 未选择状态的文本颜色 */
.placeholder-style {
  color: #999999;
}

.form-input {
  height: 80rpx;
}

.form-picker {
  height: 80rpx;
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.picker-text {
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none; /* 确保点击事件穿透到picker元素 */
}

.form-textarea {
  min-height: 100rpx;
  padding: 20rpx;
  line-height: 1.5;
  resize: vertical;
}

/* 日期提示 */
.date-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 5rpx;
  margin-left: 5rpx;
}

/* 按钮容器 */
.btn-container {
  padding: 20rpx;
}

/* 保存按钮 */
.save-btn {
  width: 100%;
  height: 90rpx;
  background-color: #ff6b6b;
  color: white;
  border-radius: 15rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn:disabled {
  background-color: #ccc;
  color: #999;
}

/* 错误提示 */
.error-message {
  color: #ff3b30;
  font-size: 24rpx;
  margin-top: 5rpx;
  margin-left: 5rpx;
}