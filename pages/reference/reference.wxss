/* pages/reference/reference.wxss */

/* 页面整体样式 */
.container {
  background-color: #FFF6F7;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 95rpx;
  box-sizing: border-box;
}

/* 图片显示区域 */
.image-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.image-section:last-of-type {
  margin-bottom: 40rpx;
}

/* 图片容器 */
.image-container {
  width: 560rpx;
  height: 560rpx;
  border-radius: 48rpx;
  border: 2rpx solid #E1BFC3;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
}

/* 图片样式 */
.display-image {
  width: 100%;
  height: 100%;
  border-radius: 46rpx;
}

/* 图片标签 */
.image-label {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #333333;
  text-align: center;
}

/* 妆妆蛋资源点区域 */
.points-section {
  position: fixed;
  top: 330rpx;
  right: 16rpx;
  z-index: 999;
}

.points-container {
  position: relative;
  display: flex;
  align-items: center;
}

.points-badge {
  background-color: #f4c00c;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 8rpx 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(244, 192, 12, 0.3);
}

.egg-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.points-number {
  font-size: 32rpx;
  color: #92404a;
  font-weight: bold;
}

/* 底部按钮 */
.bottom-button {
  width: 640rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #FFF6F7;
  border: 2rpx solid #F8ACB5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: auto;
}

.button-text {
  font-size: 30rpx;
  color: #E15C6A;
  font-weight: 500;
}