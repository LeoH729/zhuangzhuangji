<!--pages/reference/reference.wxml-->
<view class="container">
  <!-- 原图显示区 -->
  <view class="image-section">
    <view class="image-container" bindtap="previewOriginalImage">
      <image class="display-image" src="{{originalImage}}" mode="aspectFill" lazy-load="true"></image>
    </view>
    <view class="image-label">原图</view>
  </view>

  <!-- 参考图显示区 -->
  <view class="image-section">
    <view class="image-container" bindtap="previewReferenceImage">
      <image class="display-image" src="{{referenceImage}}" mode="aspectFill" lazy-load="true"
             binderror="onReferenceImageError" bindload="onReferenceImageLoad"></image>
    </view>
    <view class="image-label">参考图</view>
  </view>

  <!-- 妆妆蛋资源点区域 -->
  <view class="points-section">
    <view class="points-container">
      <view class="points-badge">
        <image class="egg-icon" src="/images/icon_zzj_egg.svg" mode="aspectFit"></image>
        <text class="points-number">{{points}}</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-button" bindtap="onBackToHome">
    <text class="button-text">返回首页</text>
  </view>
</view>