.container {
  padding-bottom: 160rpx;
}

/* Banner */
.banner-section {
  position: relative;
  width: 100%;
}
.banner-image {
  width: 100%;
  height: 500rpx;
  background: var(--color-secondary);
}
.banner-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-sub);
  font-size: 26rpx;
}
.feature-info {
  padding: 30rpx;
  background: var(--color-card-bg);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.02);
}
.feature-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 12rpx;
}
.feature-rating-stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 10rpx;
  margin-bottom: 24rpx;
}
.rating-stat-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--color-secondary, #f2f2f7);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-sub, #8e8e93);
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}
.ml-20 {
  margin-left: 20rpx;
}
.stat-icon {
  font-size: 22rpx;
  margin-right: 8rpx;
}
.stat-count {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-main, #1c1c1e);
}
.feature-cost {
  font-size: 28rpx;
  color: var(--color-text-sub);
  display: flex;
  align-items: center;
}
.feature-cost.free {
  color: var(--color-accent);
  font-weight: 500;
}
.cost-icon {
  margin-right: 8rpx;
}

/* Upload Section */
.upload-section {
  padding: 40rpx 30rpx;
  background: var(--color-bg);
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.section-desc {
  font-size: 26rpx;
  color: var(--color-text-sub);
  margin-bottom: 30rpx;
}
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.image-item, .upload-btn {
  width: calc((100% - 40rpx) / 3);
  aspect-ratio: 1;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
}
.image-item image {
  width: 100%;
  height: 100%;
}
.delete-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  line-height: 1;
}
.upload-btn {
  background: var(--color-card-bg);
  border: 2rpx dashed var(--color-border);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: var(--color-text-sub);
}
.upload-icon {
  font-size: 60rpx;
  font-weight: 300;
  margin-bottom: 10rpx;
  line-height: 1;
}
.upload-text {
  font-size: 24rpx;
}

.text-input-section {
  padding: 40rpx 30rpx 160rpx;
  background: var(--color-bg);
}

.dynamic-field {
  margin-bottom: 28rpx;
}

.field-label {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.required-mark {
  margin-left: 6rpx;
  color: #ff4d4f;
}

.field-limit {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-sub);
}

.dynamic-textarea {
  width: 100%;
  min-height: 86rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-card-bg);
  color: var(--color-text-main);
  font-size: 28rpx;
  line-height: 1.5;
}

/* Bottom Action */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(10px);
  box-sizing: border-box;
  z-index: 100;
  border-top: 1rpx solid rgba(0,0,0,0.05);
}
.action-tips {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-sub);
  margin-top: 12rpx;
}
