page {
  background-color: #FFF6F7;
}

.container {
  padding: 0;
  background-color: #FFF6F7;
  min-height: 100vh;
}

/* 区域标题 */
.section-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
  font-weight: 600;
}

/* 图片上传区域 */
.upload-container {
  margin: 32rpx 32rpx 30rpx 32rpx;
}

.upload-area {
  width: 100%;
  height: auto;
  background-color: #ffffff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 15rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  padding: 48rpx 143rpx 54rpx;
  box-sizing: border-box;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 464rpx;
  height: 464rpx;
  aspect-ratio: 1/1;
}

.camera-icon {
  width: 140rpx;
height: 140rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.upload-text {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
}

.uploaded-img {
  width: 464rpx;
  height: 464rpx;
  border-radius: 20rpx;
  object-fit: cover;
  display: block;
  background-color: #f0f0f0;
  aspect-ratio: 1/1;
}

.upload-tips {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-top: 16rpx;
}

/* 表单容器 */
.form-container {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  margin: 0 32rpx 30rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 表单项目 */
.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 35rpx;
  padding: 0;
  box-sizing: border-box;
}

.form-label-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.form-label {
  font-size: 30rpx;
  color: #333;
  display: flex;
  align-items: center;
  font-weight: 500;
}

.char-count {
  font-size: 24rpx;
  color: #999999;
}

.required {
  position: relative;
}

.required::before {
  content: '*';
  color: #ff3b30;
  margin-right: 5rpx;
}

.input-container {
  width: 100%;
  position: relative;
  cursor: pointer;
  padding: 16rpx 16rpx 0;
  box-sizing: border-box;
}

.form-input,
.form-picker,
.form-textarea {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 16rpx;
  font-size: 30rpx;
  background-color: #fafafa;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.form-picker {
  z-index: 10;
  position: relative;
}

.picker-text {
  width: 100%;
  height: 100%;
  display: block;
}

/* 设置placeholder的颜色 */
.form-input::placeholder,
.form-textarea::placeholder {
  color: #999999;
}

.form-input:focus,
.form-picker:focus,
.form-textarea:focus {
  border-color: #F29AA1;
  background-color: #fff;
}

.form-input {
  height: 88rpx;
}

.form-picker {
  height: 88rpx;
  display: flex;
  align-items: center;
}

.picker-text {
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  pointer-events: none; /* 确保点击事件穿透到picker元素 */
}

/* 未选择状态的文本颜色 */
.placeholder-style {
  color: #999999;
}

.form-input::placeholder,
.form-textarea::placeholder {
  color: #999999;
}

.form-textarea {
  min-height: 100rpx;
  padding: 20rpx;
  line-height: 1.6;
  resize: vertical;
  font-size: 30rpx;
}

/* 日期提示 */
.date-tip {
  font-size: 26rpx;
  color: #F29AA1;
  margin-top: 10rpx;
  margin-left: 5rpx;
  font-weight: 400;
}

/* 按钮容器 */
.btn-container {
  padding: 30rpx 32rpx;
}

/* 保存按钮 */
.save-btn {
  width: 100%;
  height: 100rpx;
  background-color: #F29AA1;
  color: #431317;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(242, 154, 161, 0.3);
  transition: all 0.3s ease;
}

.save-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 15rpx rgba(242, 154, 161, 0.4);
}

.save-btn:disabled {
  background-color: #e0e0e0;
  color: #999;
  box-shadow: none;
  transform: none;
}

/* 错误提示 */
.error-message {
  color: #ff3b30;
  font-size: 24rpx;
  margin-top: 5rpx;
  margin-left: 5rpx;
}

/* 加载提示 */
.loading-toast {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-toast .weui-loading {
  margin-right: 10rpx;
}