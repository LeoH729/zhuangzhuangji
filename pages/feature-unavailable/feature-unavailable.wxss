.container {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.empty-state {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-title {
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 700;
  color: var(--color-text-main);
}

.empty-desc {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: var(--color-text-sub);
}

.empty-action {
  margin-top: 56rpx;
  width: 360rpx !important;
}
