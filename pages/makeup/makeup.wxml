<!--pages/makeup/makeup.wxml-->
<view class="studio-container {{!imageUrl ? 'empty' : ''}}">

  <!-- 1. 顶部预览区 (65%) -->
  <view class="preview-area {{!imageUrl ? 'empty' : ''}}">
    <!-- 提示按钮 (仅在有图时显示在右上角) -->
    <view class="tips-btn" bindtap="onShowTips" wx:if="{{imageUrl && tipsImageUrl}}">
      <image src="/images/icon_tips_small.svg" mode="aspectFit"></image>
    </view>

    <!-- 图片展示/上传占位 -->
    <view class="image-container {{!imageUrl ? 'flex-column' : ''}}" bindtap="chooseImage">
      <block wx:if="{{imageUrl}}">
        <view class="user-image-wrapper">
          <image class="user-image" src="{{imageUrl}}" mode="aspectFit"></image>
          <view class="reupload-hint">点击图片重新上传</view>
          <view class="delete-btn" catchtap="deleteImage">
              <image src="/images/icon_close_white.svg" mode="aspectFit"></image>
          </view>
        </view>
      </block>
      <block wx:else>
        <!-- 未上传时：显示提示图 + 上传按钮 -->
        <image class="inline-tips-img" src="{{tipsImageUrl}}" mode="widthFix" wx:if="{{tipsImageUrl}}"></image>
        <view class="placeholder-box">
          <view class="add-square">
            <image class="add-icon" src="/images/icon_zr_add.svg" mode="aspectFit"></image>
          </view>
          <text class="add-text">点击上传一张正脸照</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 2. 底部操作区 (35%) -->
  <view class="control-panel">
    <!-- 风格选择 -->
    <view class="style-section">
      <view class="section-title">选择妆容</view>
      <scroll-view class="style-list" scroll-x enable-flex>
        <block wx:for="{{styles}}" wx:key="id">
          <view 
            class="style-item {{selectedStyleId === item.id ? 'active' : ''}}" 
            bindtap="onSelectStyle" 
            data-id="{{item.id}}"
          >
            <image class="style-icon" src="{{item.icon}}" mode="aspectFill"></image>
            <text class="style-name">{{item.name}}</text>
          </view>
        </block>
      </scroll-view>
    </view>

    <!-- 底部按钮区 -->
    <view class="action-footer">
      <!-- 积分显示 -->
      <view class="points-badge" wx:if="{{showPointsSection}}" bindtap="goPointsPage">
        <image class="egg-icon" src="/images/icon_zzj_egg.svg" mode="aspectFit"></image>
        <text class="points-val">{{points}}</text>
      </view>

      <button
        class="btn-primary"
        hover-class="btn-hover"
        bindtap="analyzeImage"
        disabled="{{(!imageUrl || isUploading)}}"
      >
        立即上妆
        <text class="cost" wx:if="{{tryonCost > 0}}">(-{{tryonCost}}蛋)</text>
      </button>
    </view>
  </view>

  <!-- 提示弹窗 (Overlay) -->
  <view class="tips-overlay" wx:if="{{isTipsShow}}" bindtap="onHideTips">
    <view class="tips-card" catchtap="return">
      <view class="tips-header">
        <text>拍摄小贴士</text>
        <image class="close-icon" src="/images/icon_close_gray.svg" bindtap="onHideTips"></image>
      </view>
      <image class="tips-content" src="{{tipsImageUrl}}" mode="widthFix"></image>
    </view>
  </view>
</view>