/* pages/makeup/makeup.wxss */
page {
  height: 100vh;
  background-color: #222; /* 深色背景，沉浸感 */
  overflow: hidden;
}

.studio-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: #1a1a1a;
  transition: background-color 0.3s;
}

.studio-container.empty {
  background-color: #FFF6F7;
}

/* 1. 预览区 */
.preview-area {
  flex: 65; /* 占比 65% */
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #1a1a1a;
  transition: background-color 0.3s;
}

.preview-area.empty {
  background-color: #FFF6F7;
}

.tips-btn {
  position: absolute;
  top: 40rpx; /* 状态栏避让 */
  left: 40rpx; /* 移动到左侧 */
  z-index: 10;
  width: 66rpx;
  height: 66rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  backdrop-filter: blur(4px);
}
.tips-btn image { width: 44rpx; height: 44rpx; }

.image-container {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

.flex-column {
  flex-direction: column;
  justify-content: flex-start; /* 顶部对齐 */
  padding-top: 40rpx; /* 距离上方标题栏 40rpx */
}

.user-image-wrapper {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.inline-tips-img {
  width: calc(100% - 60rpx); /* 两侧边距各 30rpx */
  margin: 0 30rpx;
  border-radius: 20rpx;
  box-shadow: none; /* 去除阴影 */
  margin-bottom: 80rpx; /* 扩大间距 */
}

.user-image {
  width: 100%;
  height: 90%;
}

.reupload-hint {
  position: absolute;
  bottom: 80rpx; /* 向上移动，叠加在照片上 */
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(4px);
}

.delete-btn {
  position: absolute;
  top: 40rpx;
  right: 40rpx; /* 移动到右侧 */
  width: 66rpx;
  height: 66rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  backdrop-filter: blur(4px);
  z-index: 11;
}
.delete-btn image { width: 40rpx; height: 40rpx; opacity: 0.8; }


.placeholder-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.add-square {
  width: 260rpx;
  height: 260rpx;
  background: #fff;
  border: 4rpx solid #FFE4E7;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 24rpx;
}

.add-icon {
  width: 80rpx;
  height: 80rpx;
}

/* 只有在没有图片（empty）时才应用粉色主题 */
.empty .add-icon {
  opacity: 0.8;
}

.add-text {
  font-size: 30rpx;
  color: #fff;
  opacity: 0.6;
}

.empty .add-text {
  color: #E97885;
  font-weight: bold;
  opacity: 1;
}

/* 2. 操作面板 */
.control-panel {
  flex: 30; /* 占比从 35% 缩小到 30% 以降低抽屉高度 */
  background-color: #fff;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 30rpx 0 40rpx 0; /* 缩小上下内边距 */
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 -8rpx 30rpx rgba(0,0,0,0.08); /* 增强投影 */
  position: relative;
  z-index: 10; /* 确保在预览区之上，显示完整投影 */
  margin-top: -30rpx; /* 向上偏移以覆盖预览区交界 */
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin: 0 30rpx 24rpx 30rpx; /* 恢复标题的左右边距 */
}

.style-list {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  height: 240rpx; /* 增加高度以容纳阴影和缩放 */
  padding: 10rpx 0; /* 垂直内边距，水平间距通过 item margin 控制 */
  box-sizing: border-box;
}

.style-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
  padding-top: 10rpx; /* 给顶部缩放留出空间 */
  opacity: 0.6;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
}

/* 第一个元素增加左边距，确保缩放时不被截断，并满足用户 50rpx 要求 */
.style-item:first-child {
  margin-left: 50rpx;
}

/* 最后一个元素增加右边距，确保缩放时不被截断，并满足用户 50rpx 要求 */
.style-item:last-child {
  margin-right: 50rpx;
}
.style-item.active {
  opacity: 1;
  transform: scale(1.05);
}

.style-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  border: 4rpx solid transparent;
  background-color: #f7f7f7;
  margin-bottom: 12rpx;
}

.style-item.active .style-icon {
  border-color: #FF9A9E;
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 158, 0.3);
}

.style-name {
  font-size: 26rpx;
  color: #666;
}
.style-item.active .style-name {
  color: #FF9A9E;
  font-weight: bold;
}

/* 底部按钮行 */
.action-footer {
  display: flex;
  align-items: center;
  justify-content: space-between; /* 再次改为两端对齐，容纳左侧积分类别 */
  margin-top: 30rpx; 
  padding: 0 30rpx;
}

.points-badge {
  display: flex;
  flex-direction: column; /* 垂直排列 */
  justify-content: center;
  align-items: center;
  background: #F4C00C; /* 黄色背景 */
  width: 160rpx;
  height: 88rpx;
  border-radius: 44rpx; /* 胶囊圆角 */
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(244, 192, 12, 0.4);
}

.egg-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 0;
  margin-bottom: 2rpx;
}

.points-val {
  color: #794308; /* 深色文字 */
  font-weight: 800;
  font-size: 30rpx;
  line-height: 1;
}

/* .generate-btn 已替换为全局 .btn-primary */

.cost {
  font-size: 24rpx;
  font-weight: normal;
  opacity: 0.9;
  margin-left: 8rpx;
}

/* 提示弹窗 */
.tips-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tips-card {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}

.tips-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.tips-header text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
}

.tips-content {
  width: 100%;
  border-radius: 12rpx;
}