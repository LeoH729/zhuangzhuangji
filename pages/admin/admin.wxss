/* 管理员页面样式 */
.container {
  padding: 24rpx 32rpx;
  background-color: #FFF6F7;
  min-height: 100vh;
}

.header { margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #333333; }
.subtitle { margin-top: 8rpx; font-size: 26rpx; color: #888888; }

/* 菜单列表 */
.menu-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  flex: 1;
}

.menu-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.menu-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

/* 分隔线 */
.section-divider {
  height: 2rpx;
  background: #eee;
  margin: 40rpx 0;
}

.form { margin-top: 24rpx; }
.label { font-size: 28rpx; color: #92404a; }
.input {
  margin-top: 16rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  border: 1rpx solid #e1bfc3;
}

.textarea {
  margin-top: 16rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  min-height: 200rpx;
  border: 1rpx solid #e1bfc3;
}

.publish-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  border: none;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f8acb5;
  color: #333333;
}
.publish-btn::after { border: none; }

.tips { margin-top: 32rpx; color: #666666; font-size: 24rpx; }