/* 管理员页面样式 */
.container {
  padding: 24rpx 32rpx;
  background-color: #FFF6F7;
  min-height: 100vh;
}

.header { margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #333333; }
.subtitle { margin-top: 8rpx; font-size: 26rpx; color: #888888; }

.form { margin-top: 24rpx; }
.label { font-size: 28rpx; color: #92404a; }
.input {
  margin-top: 16rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  border: 1rpx solid #e1bfc3;
}

.textarea {
  margin-top: 16rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  min-height: 200rpx;
  border: 1rpx solid #e1bfc3;
}

.publish-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  border: none;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f8acb5;
  color: #333333;
}
.publish-btn::after { border: none; }

.tips { margin-top: 32rpx; color: #666666; font-size: 24rpx; }