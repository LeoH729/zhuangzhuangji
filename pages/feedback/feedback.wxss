/* pages/feedback/feedback.wxss */
page {
  background-color: #FFF6F7;
  padding: 30rpx;
  box-sizing: border-box;
  width: 100vw;
}

.form-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #666;
}

.arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

.content-input {
  width: 100%;
  height: 240rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  box-sizing: border-box;
}

.contact-input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #eee;
  box-sizing: border-box;
}

.submit-btn {
  background: #333;
  color: #fff;
  border-radius: 50rpx;
  margin-top: 60rpx;
  font-weight: bold;
}
