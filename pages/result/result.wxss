.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}
.result-box-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-bottom: 30rpx;
}
.result-box {
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 40rpx 20rpx 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.result-image {
  width: 100%;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  background: var(--color-secondary);
}
.result-image-fallback {
  min-height: 720rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-sub);
  font-size: 28rpx;
}
.action-box {
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--color-card-bg);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.03);
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.result-action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-action-btn::after {
  border: none;
}

.result-action-primary {
  background: #111111;
  color: #ffffff;
  border: 2rpx solid #111111;
}

.result-action-secondary {
  background: #ffffff;
  color: #111111;
  border: 2rpx solid #111111;
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 940px;
}

/* =========================================================================
 * 评价模块 — 极简优雅风格
 * ========================================================================= */
.rating-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 40rpx 0;
  box-sizing: border-box;
}

.rating-hint {
  font-size: 24rpx;
  color: var(--color-text-sub);
  letter-spacing: 1rpx;
  margin-bottom: 24rpx;
}

.rating-actions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
}

/* 胶囊按钮 */
.rate-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 40rpx;
  border-radius: 60rpx;
  background: var(--color-card-bg);
  border: 2rpx solid var(--color-border);
  transition: all 0.25s ease;
}

.rate-pill:active {
  transform: scale(0.95);
  background: var(--color-secondary);
}

.rate-emoji {
  font-size: 32rpx;
  line-height: 1;
}

.rate-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
  line-height: 1.2;
}

/* ---- 选中态 ---- */
.rate-pill.selected {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.rate-pill.selected .rate-label {
  color: #FFFFFF;
}

/* ---- 未选中项淡出 ---- */
.rate-pill.faded {
  opacity: 0.3;
  border-color: var(--color-border);
  background: var(--color-secondary);
}

.rate-pill.faded .rate-label {
  color: var(--color-text-sub);
}

/* ---- 锁定态（已评价后禁止再点） ---- */
.rate-pill.locked {
  pointer-events: none;
}

.rate-pill.locked:active {
  transform: none;
}
