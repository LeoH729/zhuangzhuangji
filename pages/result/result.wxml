<!--pages/result/result.wxml-->
<view class="container">
  <!-- 核心对比区 (全屏自适应，留出底部按钮高度) -->
  <view class="compare-container" bindtouchmove="onSliderMove" bindtouchstart="onSliderMove">
    
    <!-- 1. 底层：原图 -->
    <view class="image-layer original-layer">
      <image src="{{originalImage}}" mode="aspectFit" class="comp-img"></image>
      <view class="layer-tag left">原图</view>
    </view>
    
    <!-- 2. 上层：效果图 (通过宽度控制显示区域) -->
    <view class="image-layer result-layer" style="width: {{sliderValue}}%;">
      <image src="{{resultImage}}" mode="aspectFit" class="comp-img"></image>
      <view class="layer-tag right" style="opacity: {{sliderValue < 15 ? 0 : 1}}">上妆后</view>
    </view>
    
    <!-- 3. 这个是分割线和拖拽手柄 -->
    <view class="slider-handle-line" style="left: {{sliderValue}}%;">
      <view class="slider-arrow">
        <image src="/images/icon_slider_arrow.svg" mode="aspectFit"></image> <!-- 需准备图标，或用纯CSS箭头 -->
      </view>
    </view>
    
  </view>

  <!-- 底部操作区 -->
  <view class="footer-actions">
    <view style="width: 240rpx;">
      <button class="btn-secondary-dark" hover-class="btn-hover" bindtap="goHome">返回首页</button>
    </view>
    <view style="width: 380rpx;">
      <button class="btn-primary" hover-class="btn-hover" bindtap="saveImage">保存美照</button>
    </view>
  </view>
</view>