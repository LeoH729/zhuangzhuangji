<!-- 首页：化妆品列表展示 -->
<view class="container">
  <!-- 顶部统计信息 -->
  <view class="stats-container" wx:if="{{cosmetics.length > 0}}">
    <view class="stat-item">
      <text class="stat-number">{{totalCount}}</text>
      <text class="stat-label">总数量</text>
    </view>
    <view class="stat-item warning">
      <text class="stat-number">{{expiringCount}}</text>
      <text class="stat-label">即将过期</text>
    </view>
    <view class="stat-item danger">
      <text class="stat-number">{{expiredCount}}</text>
      <text class="stat-label">已过期</text>
    </view>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="closeEditModal"></view>
  <view class="modal-container" wx:if="{{showEditModal}}">
    <view class="modal-header">
      <text class="modal-title">编辑化妆品</text>
      <view class="modal-close" bindtap="closeEditModal"></view>
    </view>
    <view class="modal-content">
      <!-- 图片上传区域 -->
      <view class="upload-container">
        <text class="section-title">化妆品图片</text>
        <view class="upload-area" bindtap="chooseImage">
          <image wx:if="{{editForm.imageUrl}}" src="{{editForm.imageUrl}}" class="uploaded-img" mode="aspectFill"></image>
          <view wx:else class="upload-placeholder">
            <image src="/images/icon_camera.png" class="camera-icon"></image>
            <text class="upload-text">点击上传图片</text>
          </view>
          <view class="upload-tips">支持拍照或从相册选择</view>
        </view>
      </view>

      <!-- 表单区域 -->
      <view class="form-container">
        <!-- 名称输入 -->
        <view class="form-item">
          <text class="form-label required">名称</text>
          <view class="input-container" bindtap="handleInputFocus" data-field="name">
            <input class="form-input" placeholder="请输入化妆品名称" value="{{editForm.name}}" bindinput="onInputChange" bindfocus="handleFocus" data-field="name"></input>
          </view>
        </view>

        <!-- 类别选择 -->
        <view class="form-item">
          <text class="form-label required">类别</text>
          <view class="input-container">
            <picker class="form-picker" value="{{editForm.categoryIndex}}" range="{{categories}}" bindchange="onCategoryChange" data-field="category">
              <view class="picker-text {{!editForm.category ? 'placeholder-style' : ''}}">{{editForm.category || '请选择类别'}}</view>
            </picker>
          </view>
        </view>

        <!-- 开封日期 -->
        <view class="form-item">
          <text class="form-label">开封日期</text>
          <view class="input-container">
            <picker class="form-picker" mode="date" value="{{editForm.purchaseDate}}" start="2000-01-01" end="{{currentDate}}" bindchange="onPurchaseDateChange" data-field="purchaseDate">
              <view class="picker-text {{!editForm.purchaseDate ? 'placeholder-style' : ''}}">{{editForm.purchaseDate || '请选择开封日期'}}</view>
            </picker>
          </view>
        </view>

        <!-- 过期日期 -->
        <view class="form-item">
          <text class="form-label required">过期日期</text>
          <view class="input-container">
            <picker class="form-picker" mode="date" value="{{editForm.expiryDate}}" start="{{currentDate}}" end="2050-12-31" bindchange="onExpiryDateChange" data-field="expiryDate">
              <view class="picker-text {{!editForm.expiryDate ? 'placeholder-style' : ''}}">{{editForm.expiryDate || '请选择过期日期'}}</view>
            </picker>
          </view>
          <text class="date-tip">* 请选择准确的过期日期以获取提醒</text>
        </view>

        <!-- 备注信息 -->
        <view class="form-item">
          <view class="form-label-container">
            <text class="form-label">备注</text>
            <text class="char-count">{{editForm.remarks.length || 0}}/14</text>
          </view>
          <view class="input-container" bindtap="handleInputFocus" data-field="remarks">
            <textarea class="form-textarea" placeholder="添加备注信息（可选）" value="{{editForm.remarks}}" bindinput="onInputChange" bindfocus="handleFocus" data-field="remarks" maxlength="14" style="height:100rpx;"></textarea>
          </view>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="cancel-btn" bindtap="closeEditModal">取消</button>
      <button class="save-btn" bindtap="saveCosmetic">保存</button>
    </view>
  </view>

  <!-- 列表区域 -->
  <view class="list-container {{cosmetics.length > 0 ? 'has-data' : 'empty'}}">
    <!-- 空状态 -->
    <view wx:if="{{cosmetics.length === 0}}" class="empty-state">
      <view class="empty-content">

        <view class="cosmetic-illustration">
           <image src="/images/empty.png" class="illustration-img" mode="aspectFit"></image>
         </view>
        <button class="add-cosmetic-btn" bindtap="navigateToAdd">
          <text class="btn-icon">+</text>
          <text class="btn-text">添加化妆品</text>
        </button>
      </view>
    </view>

    <!-- 化妆品列表 -->
    <view wx:else class="cosmetic-list">
      <block wx:for="{{cosmetics}}" wx:key="id">
        <view class="cosmetic-item">
          <view class="item-left">
            <!-- 化妆品图片 -->
            <view class="item-img-container">
              <image src="{{item.imageUrl}}" class="item-img" mode="aspectFill"></image>
              <!-- 过期状态标记 -->
              <view wx:if="{{item.isExpired}}" class="status-badge expired">已过期</view>
              <view wx:elif="{{item.isTodayExpired}}" class="status-badge today-expired">今天过期</view>
              <view wx:elif="{{item.daysLeft <= reminderDays}}" class="status-badge warning">即将过期</view>
            </view>
            
            <!-- 剩余天数 -->
            <view class="item-days-left {{item.isExpired ? 'danger' : (item.isTodayExpired ? 'today-expired' : (item.daysLeft <= reminderDays ? 'warning' : ''))}}">
              {{item.isTodayExpired ? '今天过期' : item.daysLeft > 0 ? '剩余' + item.daysLeft + '天' : '已过期'}}
            </view>
          </view>

          <!-- 化妆品信息 -->
          <view class="item-right">
            <view class="item-name-container">
              <text class="item-name">{{item.displayName || item.name}}</text>
              <image wx:if="{{!item.isExpired && item.reminderEnabled}}" 
                     class="reminder-bell-icon" 
                     src="/images/icon_reminder_opening.svg" 
                     bindtap="toggleReminder" 
                     data-id="{{item._id}}"></image>
              <image wx:elif="{{!item.isExpired && !item.reminderEnabled}}" 
                     class="reminder-bell-icon" 
                     src="/images/icon_reminder_closed.svg" 
                     bindtap="toggleReminder" 
                     data-id="{{item._id}}"></image>
            </view>
            <view class="item-category">{{item.category}}</view>
            <view class="item-details">
              <view class="detail-item">
                <text class="detail-label">开封日期：</text>
                <text class="detail-value">{{item.purchaseDate || '未设置'}}</text>
              </view>
              <view class="detail-item">
                <text class="detail-label">到期日期：</text>
                <text class="detail-value">{{item.expiryDate}}</text>
              </view>
              <view wx:if="{{item.remarks}}" class="detail-item">
                <text class="detail-label">备注：</text>
                <text class="detail-value">{{item.remarks}}</text>
              </view>
            </view>
            
            <!-- 操作按钮 -->
            <view class="item-actions">
              <image class="action-icon edit-icon" src="/images/icon_list_edit.svg" bindtap="openEditModal" data-id="{{item._id}}"></image>
              <image class="action-icon delete-icon" src="/images/icon_list_delete.svg" bindtap="handleDelete" data-id="{{item._id}}"></image>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 提醒设置弹窗 -->
  <view class="modal-mask" wx:if="{{showReminderModal}}" bindtap="closeReminderModal"></view>
  <view class="modal-container reminder-modal" wx:if="{{showReminderModal}}">
    <view class="modal-header">
      <text class="modal-title">设置过期提醒</text>
      <view class="modal-close" bindtap="closeReminderModal"></view>
    </view>
    <view class="modal-content">
      <view class="reminder-info">
        <text class="cosmetic-name">{{selectedCosmetic.name}}</text>
        <text class="expiry-info">过期日期：{{selectedCosmetic.expiryDate}}</text>
        <text class="reminder-desc">将在过期前7天提醒您</text>
      </view>
      <view class="modal-actions">
        <button class="cancel-btn" bindtap="closeReminderModal">取消</button>
        <button class="confirm-btn" catchtap="requestSubscribeMessage">确认设置</button>
      </view>
    </view>
  </view>
</view>