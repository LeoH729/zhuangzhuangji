.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 统计信息容器 */
.stats-container {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.stat-item.warning .stat-number {
  color: #ff9500;
}

.stat-item.danger .stat-number {
  color: #ff3b30;
}

/* 列表容器 */
.list-container {
  background-color: #fff;
  border-radius: 16rpx;
  min-height: calc(100vh - 200rpx);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.add-btn {
  background-color: #ff6b6b;
  color: white;
  padding: 15rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 编辑弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.modal-container {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  padding: 20rpx;
  z-index: 1000;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.modal-close::before, .modal-close::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 30rpx;
  height: 2rpx;
  background-color: #999;
}

.modal-close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.modal-close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.modal-content {
  padding-bottom: 20rpx;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
}

.cancel-btn {
  flex: 1;
  margin-right: 20rpx;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.save-btn {
  flex: 1;
  background-color: #ff6b6b;
  color: white;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 表单样式 */
.upload-container {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}

.upload-area {
  width: 100%;
  height: 200rpx;
  background-color: #f9f9f9;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.uploaded-img {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.camera-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
  opacity: 0.5;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.upload-tips {
  font-size: 20rpx;
  color: #ccc;
  margin-top: 10rpx;
}

.form-container {
  padding: 0 10rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.form-label.required::after {
  content: '*';
  color: #ff3b30;
  margin-left: 5rpx;
}

.form-input, .form-picker {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.picker-text {
  line-height: 80rpx;
  color: #666;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.date-tip {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* 化妆品列表 */
.cosmetic-list {
  padding: 10rpx;
}

.cosmetic-item {
  display: flex;
  padding: 15rpx;
  border-bottom: 1rpx solid #f5f5f5;
  align-items: center;
}

.cosmetic-item.expanded {
  flex-direction: column;
  align-items: flex-start;
  padding: 20rpx;
}

.cosmetic-item.expanded .item-img-container {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 15rpx;
}

.item-details {
  width: 100%;
  margin-top: 10rpx;
}

.detail-item {
  display: flex;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.detail-item.notes {
  flex-direction: column;
}

.detail-label {
  width: 120rpx;
  color: #999;
}

.detail-value {
  flex: 1;
}

.item-days-left.today-expired {
  color: #ff7d00;
}

.edit-btn {
  background-color: #f5f5f5;
  color: #007aff;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
}

.item-img-container {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.item-img {
  width: 100%;
  height: 100%;
}

.status-badge {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  padding: 3rpx 10rpx;
  font-size: 20rpx;
  color: white;
  border-radius: 20rpx;
}

.status-badge.warning {
  background-color: #ff9500;
}

.status-badge.today-expired {
  background-color: #ff7d00;
}

.status-badge.expired {
  background-color: #ff3b30;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
  padding-right: 10rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-category {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.item-expiry {
  font-size: 24rpx;
  color: #666;
}

.item-days-left {
  font-size: 24rpx;
  margin-top: 5rpx;
}

.item-days-left.warning {
  color: #ff9500;
}

.item-days-left.danger {
  color: #ff3b30;
}

.item-actions {
  display: flex;
  align-items: center;
}

.delete-btn {
  background-color: #f5f5f5;
  color: #ff3b30;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* 下拉刷新样式 */
.refresh-trigger {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.refresh-text {
  font-size: 24rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}