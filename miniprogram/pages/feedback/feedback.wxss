.container {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 40rpx;
}
.form-group {
  margin-bottom: 40rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 20rpx;
}
.picker-view {
  background: var(--color-card-bg);
  height: 100rpx;
  border-radius: var(--radius-md);
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  color: var(--color-text-main);
  box-shadow: var(--shadow-sm);
}
.arrow {
  color: var(--color-text-sub);
  font-family: monospace;
}
.textarea {
  width: 100%;
  height: 300rpx;
  background: var(--color-card-bg);
  border-radius: var(--radius-md);
  padding: 30rpx;
  font-size: 30rpx;
  color: var(--color-text-main);
  box-sizing: border-box;
  box-shadow: var(--shadow-sm);
}
.word-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-top: 16rpx;
}
.action-box {
  margin-top: 60rpx;
}
.mt-30 {
  margin-top: 30rpx !important;
}
