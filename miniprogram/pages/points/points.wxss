.container {
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-bg);
  min-height: 100vh;
}
.balance-card {
  margin: 40rpx;
  background: var(--color-primary);
  border-radius: var(--radius-lg);
  padding: 60rpx 40rpx;
  box-shadow: var(--shadow-md);
  text-align: center;
}
.balance-title {
  color: rgba(255,255,255,0.7);
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.balance-value {
  display: flex;
  justify-content: center;
  align-items: center;
}
.points-num {
  color: #fff;
  font-size: 80rpx;
  font-weight: bold;
}

.section-title {
  padding: 0 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
  margin-top: 50rpx;
}

.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
  padding: 0 40rpx;
}
.option-item {
  width: calc((100% - 30rpx) / 2);
  background: var(--color-card-bg);
  border: 4rpx solid transparent;
  border-radius: var(--radius-md);
  padding: 40rpx 0;
  text-align: center;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
  position: relative;
}
.option-item.active {
  border-color: var(--color-primary);
  background: rgba(0,0,0,0.02);
}
.option-amount {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 10rpx;
}
.option-price {
  font-size: 28rpx;
  color: var(--color-accent);
  font-weight: 500;
}
.option-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: var(--color-primary);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 var(--radius-md) 0 var(--radius-md);
}

.action-area {
  padding: 60rpx 40rpx;
}

.history-list {
  background: var(--color-card-bg);
  margin: 0 40rpx 40rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.history-item:last-child {
  border-bottom: none;
}
.left {
  display: flex;
  flex-direction: column;
}
.item-title {
  font-size: 30rpx;
  color: var(--color-text-main);
  margin-bottom: 8rpx;
}
.item-time {
  font-size: 24rpx;
  color: var(--color-text-sub);
}
.right {
  font-size: 36rpx;
  font-weight: bold;
}
.right.plus {
  color: #007AFF;
}
.right.minus {
  color: var(--color-text-main);
}
.empty-view {
  padding: 60rpx;
  text-align: center;
  color: var(--color-text-sub);
}
