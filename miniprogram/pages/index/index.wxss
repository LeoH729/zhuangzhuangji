.container {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Tabs */
.tab-list {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
  padding: 20rpx 30rpx;
  background: rgba(247, 248, 250, 0.85);
  backdrop-filter: blur(12px);
  position: sticky;
  top: 0;
  z-index: 100;
}
.tab-item {
  display: inline-block;
  padding: 12rpx 36rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
  color: var(--color-text-sub);
  background: var(--color-card-bg);
  border-radius: 36rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}
.tab-item.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
  transform: scale(1.02);
}

/* Waterfall */
.waterfall {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx 30rpx 30rpx;
  align-items: flex-start;
}
.waterfall-col {
  width: calc((100% - 20rpx) / 2);
  flex: 0 0 calc((100% - 20rpx) / 2);
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.card {
  width: 100%;
  min-width: 0;
  background: var(--color-card-bg);
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}
.card-image-wrap {
  width: 100%;
  font-size: 0;
  background-color: var(--color-secondary);
}
.card-image {
  width: 100%;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  min-height: 200rpx; /* Prevent total collapse before load */
}
.card-image-fallback {
  min-height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-sub);
  font-size: 24rpx;
  background: #F5F5F7;
}
.card-content {
  padding: 24rpx 20rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 20rpx;
  line-height: 1.4;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}
.card-cost {
  font-size: 24rpx;
  color: var(--color-text-sub);
  display: flex;
  align-items: center;
  min-width: 0;
  flex-shrink: 1;
}
.card-cost.free {
  color: var(--color-accent);
  font-weight: 600;
}
.cost-icon {
  margin-right: 6rpx;
  font-size: 24rpx;
}
.card-btn {
  font-size: 22rpx;
  background: var(--color-primary);
  color: #fff;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* Loading & Empty */
.loading {
  display: flex;
  justify-content: center;
  padding: 60rpx;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(0,0,0,0.05);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--color-text-sub);
  font-size: 28rpx;
}

/* Badge & Rating Stats Styles */
.card-image-wrap {
  position: relative;
}
.card-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  font-size: 16rpx;
  font-weight: 800;
  color: #ffffff;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
  z-index: 5;
  text-transform: uppercase;
}
.card-badge.hot {
  background: linear-gradient(135deg, #ff0844 0%, #ffb199 100%);
}
.card-badge.new {
  background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%);
}
.card-rating-stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}
.rating-stat-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #f2f2f7;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #8e8e93;
  font-weight: 500;
}
.ml-20 {
  margin-left: 20rpx !important;
}
.stat-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
  line-height: 1;
}
.stat-count {
  font-size: 20rpx;
  font-weight: 600;
}
