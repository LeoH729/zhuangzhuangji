/* pages/feedback-list/feedback-list.wxss */
page {
  background-color: #FFF6F7;
  min-height: 100vh;
}

.feedback-list-container {
  padding: 30rpx;
}

/* 反馈列表 */
.feedback-list {
  min-height: 400rpx;
}

.feedback-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.feedback-type {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.feedback-time {
  font-size: 24rpx;
  color: #999;
}

.feedback-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.feedback-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.feedback-id-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.feedback-id {
  font-size: 22rpx;
  color: #999;
}

.copy-btn {
  font-size: 22rpx;
  color: #f8acb5;
  padding: 4rpx 12rpx;
  border: 1rpx solid #f8acb5;
  border-radius: 8rpx;
  background: #fff;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.detail-row {
  margin-bottom: 24rpx;
}

.detail-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.openid-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.openid-text {
  flex: 1;
  word-break: break-all;
  font-size: 24rpx;
  color: #666;
}

.copy-btn-small {
  font-size: 24rpx;
  color: #f8acb5;
  padding: 8rpx 20rpx;
  border: 1rpx solid #f8acb5;
  border-radius: 8rpx;
  background: #fff;
  white-space: nowrap;
}

.content-text {
  display: block;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  display: inline-block;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  padding: 30rpx;
  border: none;
  border-radius: 0;
  font-size: 30rpx;
  font-weight: bold;
}

.cancel-btn {
  background: #fff;
  color: #666;
  border-right: 1rpx solid #eee;
}

.confirm-btn {
  background: #333;
  color: #fff;
}

.modal-btn.single {
  border-right: none;
}

/* 分隔线 */
.section-divider {
  height: 2rpx;
  background: #eee;
  margin: 40rpx 0;
}
