<!-- pages/feedback-list/feedback-list.wxml -->
<view class="container">
  <view class="feedback-list">
    <view class="feedback-item" wx:for="{{feedbackList}}" wx:key="_id" bindtap="onFeedbackDetail" data-id="{{item._id}}">
      <view class="feedback-header">
        <text class="feedback-type">{{item.type}}</text>
        <text class="feedback-time">{{item.createTime}}</text>
      </view>
      <view class="feedback-content">{{item.content}}</view>
      <view class="feedback-footer">
        <view class="feedback-id-wrapper">
          <text class="feedback-id">OpenID：{{item.openid}}</text>
          <text class="copy-btn" catchtap="onCopyOpenid" data-openid="{{item.openid}}">复制</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{feedbackList.length === 0 && !loading}}">
      <text class="empty-text">暂无反馈数据</text>
    </view>

    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>

  <view class="modal" wx:if="{{showDetail}}">
    <view class="modal-mask" bindtap="onCloseDetail"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">反馈详情</text>
        <text class="modal-close" bindtap="onCloseDetail">×</text>
      </view>
      <view class="modal-body">
        <view class="detail-row">
          <text class="detail-label">反馈类型：</text>
          <text class="detail-value">{{currentFeedback.type}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">反馈内容：</text>
          <text class="detail-value content-text">{{currentFeedback.content}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">提交时间：</text>
          <text class="detail-value">{{currentFeedback.createTime}}</text>
        </view>
        <view class="detail-row" wx:if="{{currentFeedback.updateTime}}">
          <text class="detail-label">更新时间：</text>
          <text class="detail-value">{{currentFeedback.updateTime}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">用户OpenID：</text>
          <view class="openid-wrapper">
            <text class="detail-value openid-text">{{currentFeedback.openid}}</text>
            <text class="copy-btn-small" catchtap="onCopyOpenid" data-openid="{{currentFeedback.openid}}">复制</text>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn cancel-btn single" bindtap="onCloseDetail">关闭</button>
      </view>
    </view>
  </view>
</view>
