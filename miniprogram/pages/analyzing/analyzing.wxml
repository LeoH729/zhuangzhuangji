<view class="container wait-page">
  <view class="wait-hero">
    <view class="wait-kicker">AI IMAGE LAB</view>
    <view class="loading-title">AI绘制可能要1-5分钟 玩会小游戏吧</view>
    <view class="status-row">
      <text class="loading-subtitle">{{statusText}}</text>
      <text class="elapsed-timer">{{elapsedText}}</text>
    </view>
  </view>

  <view class="progress-section">
    <view class="progress-meta">
      <text>生成进度</text>
      <text>{{progressText}}%</text>
    </view>
    <view class="progress-bar">
      <view class="progress-inner" style="width: {{progress}}%"></view>
    </view>
  </view>

  <view class="game-panel">
    <view class="game-head">
      <view>
        <view class="game-title">SNAKE WAIT</view>
        <view class="game-subtitle">在棋盘中滑动控制方向</view>
      </view>
      <view class="game-score">
        <text>得分 {{snakeScore}}</text>
        <text>最佳 {{snakeBest}}</text>
      </view>
    </view>

    <view
      class="snake-board"
      bindtouchstart="onSnakeTouchStart"
      catchtouchmove="onSnakeTouchMove"
    >
      <view
        wx:for="{{snakeCells}}"
        wx:key="key"
        class="snake-cell {{item.type}}"
      ></view>
      <view wx:if="{{snakeGameOver}}" class="game-over-layer">
        <view class="game-over-text">GAME OVER</view>
        <button class="restart-btn" bindtap="resetSnakeGame">再来一局</button>
      </view>
    </view>
  </view>

  <view class="bottom-actions">
    <button class="btn-outline {{resultReady ? 'ready' : ''}}" bindtap="handleBottomAction" hover-class="btn-hover">
      {{resultReady ? '生图完成啦 去看看' : '不玩了 逛逛别的'}}
    </button>
  </view>
</view>
