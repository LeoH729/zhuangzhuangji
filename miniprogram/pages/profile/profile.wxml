<view class="container pb-safe">
  <view wx:if="{{generationNotice.visible}}" class="generation-notice" bindtap="onGenerationNoticeTap">
    <image class="generation-notice-icon" src="/images/ic_picture.png" mode="aspectFit"></image>
    <view class="generation-notice-copy">
      <text class="generation-notice-title">生图完成</text>
      <text class="generation-notice-text">{{generationNotice.message}}</text>
    </view>
    <view class="generation-notice-action">立即查看</view>
  </view>

  <view class="user-header">
    <view class="avatar-wrap">
      <image class="avatar fade-in {{avatarLoaded ? 'visible' : 'skeleton-shimmer skeleton-bg'}}" src="{{userInfo.avatarUrl || 'https://dummyimage.com/150'}}" mode="aspectFill" bindload="onAvatarLoad" binderror="onAvatarError"></image>
    </view>
    <view class="user-info" wx:if="{{hasUserInfo}}">
      <view class="nickname">{{userInfo.nickName}}</view>
      <view class="register-date">注册于 {{registerDate}}</view>
    </view>
    <view class="user-info" wx:else>
      <button class="login-btn" bindtap="getUserProfile">点击登录体验更多功能</button>
    </view>
  </view>

  <view class="points-card" bindtap="goToPoints">
    <view class="pc-left">
      <view class="pc-title">我的星光</view>
      <view class="pc-num">{{points}}</view>
    </view>
    <view class="pc-right">
      <view class="pc-btn">去充值</view>
    </view>
  </view>

  <view class="star-task-card">
    <view class="star-task-title">✨ 星光任务</view>
    <block wx:if="{{starTasks.length > 0}}">
      <view wx:for="{{starTasks}}" wx:key="taskId" class="star-task-row {{item.completed ? 'done' : ''}}" bindtap="onStarTaskTap" data-task-id="{{item.taskId}}">
        <view class="star-task-copy">
          <view class="star-task-main">
            <text>{{item.title}}</text>
            <text class="star-task-reward">✨星光+{{item.displayReward}}</text>
          </view>
          <view class="star-task-desc">{{item.desc}}</view>
        </view>
        <view class="star-task-action {{item.completed ? 'done' : ''}}">{{item.actionText}}</view>
      </view>
    </block>
    <view wx:elif="{{starTasksLoadFailed}}" class="star-task-retry" bindtap="fetchStarTasks">任务加载失败，点击重试</view>
    <block wx:else>
      <view wx:for="{{starTaskSkeletonRows}}" wx:key="*this" class="star-task-skeleton">
        <view class="star-task-skeleton-copy">
          <view class="star-task-skeleton-line star-task-skeleton-main"></view>
          <view class="star-task-skeleton-line star-task-skeleton-desc"></view>
        </view>
        <view class="star-task-skeleton-action"></view>
      </view>
    </block>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goToHistory">
      <view class="menu-icon">📋</view>
      <view class="menu-text">生成列表</view>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" bindtap="goToPoints">
      <view class="menu-icon">💰</view>
      <view class="menu-text">消费明细</view>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" bindtap="goToFeedback">
      <view class="menu-icon">📝</view>
      <view class="menu-text">意见反馈</view>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" bindtap="showAbout">
      <view class="menu-icon">ℹ️</view>
      <view class="menu-text">关于我们</view>
      <view class="menu-arrow">></view>
    </view>
  </view>
</view>

<reward-modal visible="{{newUserGiftModalVisible}}" variant="gift"></reward-modal>
