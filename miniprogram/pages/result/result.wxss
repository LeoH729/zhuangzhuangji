.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}
.result-box-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-bottom: 30rpx;
}
.result-box {
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 40rpx 20rpx 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.result-image {
  width: 100%;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  background: var(--color-secondary);
}
.result-image-fallback {
  min-height: 720rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-sub);
  font-size: 28rpx;
}
.action-box {
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--color-card-bg);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.03);
  position: relative;
}

.action-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.reward-bubble {
  position: absolute;
  right: 66rpx;
  top: -26rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #111111;
  font-size: 22rpx;
  font-weight: 600;
  border: 1rpx solid rgba(17, 17, 17, 0.08);
  box-shadow: 0 10rpx 28rpx rgba(0,0,0,0.14);
  animation: reward-bubble-bounce 1.8s ease-in-out infinite;
  transform-origin: center bottom;
}

.reward-bubble::after {
  content: "";
  position: absolute;
  right: 42rpx;
  bottom: -8rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ffffff;
  border-right: 1rpx solid rgba(17, 17, 17, 0.08);
  border-bottom: 1rpx solid rgba(17, 17, 17, 0.08);
  transform: rotate(45deg);
}

@keyframes reward-bubble-bounce {
  0%,
  100% {
    transform: translateY(0) scale(1);
  }
  38% {
    transform: translateY(-10rpx) scale(1.04);
  }
  58% {
    transform: translateY(2rpx) scale(0.99);
  }
  74% {
    transform: translateY(-4rpx) scale(1.015);
  }
}

.result-action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-action-btn::after {
  border: none;
}

.result-action-primary {
  background: #111111;
  color: #ffffff;
  border: 2rpx solid #111111;
}

.result-action-secondary {
  background: #ffffff;
  color: #111111;
  border: 2rpx solid #111111;
}

.share-panel-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(0,0,0,0.36);
  display: flex;
  align-items: flex-end;
}

.share-panel {
  width: 100%;
  padding: 28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
}

.share-panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111111;
  padding: 8rpx 8rpx 24rpx;
}

.share-panel-item {
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  text-align: left;
  border-bottom: 1rpx solid var(--color-border);
}

.share-panel-item::after {
  border: none;
}

.share-panel-item.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.share-panel-icon {
  width: 56rpx;
  font-size: 34rpx;
  color: #111111;
}

.share-panel-text {
  flex: 1;
  font-size: 30rpx;
  color: #111111;
}

.save-panel-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.save-panel-desc {
  font-size: 24rpx;
  line-height: 1.3;
  color: var(--color-text-sub);
}

.share-panel-cancel {
  height: 88rpx;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: var(--color-secondary);
  color: var(--color-text-main);
  font-size: 28rpx;
  font-weight: 600;
}

.share-panel-cancel.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 940px;
}

/* =========================================================================
 * 评价模块 — 极简优雅风格
 * ========================================================================= */
.rating-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 40rpx 0;
  box-sizing: border-box;
}

.rating-hint {
  font-size: 24rpx;
  color: var(--color-text-sub);
  letter-spacing: 1rpx;
  margin-bottom: 24rpx;
}

.rating-actions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
}

/* 胶囊按钮 */
.rate-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 40rpx;
  border-radius: 60rpx;
  background: var(--color-card-bg);
  border: 2rpx solid var(--color-border);
  transition: all 0.25s ease;
}

.rate-pill:active {
  transform: scale(0.95);
  background: var(--color-secondary);
}

.rate-emoji {
  font-size: 32rpx;
  line-height: 1;
}

.rate-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
  line-height: 1.2;
}

/* ---- 选中态 ---- */
.rate-pill.selected {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.rate-pill.selected .rate-label {
  color: #FFFFFF;
}

/* ---- 未选中项淡出 ---- */
.rate-pill.faded {
  opacity: 0.3;
  border-color: var(--color-border);
  background: var(--color-secondary);
}

.rate-pill.faded .rate-label {
  color: var(--color-text-sub);
}

/* ---- 锁定态（已评价后禁止再点） ---- */
.rate-pill.locked {
  pointer-events: none;
}

.rate-pill.locked:active {
  transform: none;
}
