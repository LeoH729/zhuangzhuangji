<view class="container">
  <view wx:if="{{generationNotice.visible}}" class="generation-notice" catchtap="onGenerationNoticeTap">
    <image class="generation-notice-icon" src="/images/ic_picture.png" mode="aspectFit"></image>
    <view class="generation-notice-copy">
      <text class="generation-notice-title">生图完成</text>
      <text class="generation-notice-text">{{generationNotice.message}}</text>
    </view>
    <view class="generation-notice-action">立即查看</view>
  </view>

  <view class="group-filter" wx:if="{{groups.length > 0}}">
    <view
      class="group-chip {{currentGroup === item ? 'active' : ''}}"
      wx:for="{{groups}}"
      wx:key="*this"
      bindtap="onGroupSelect"
      data-group="{{item}}"
    >
      {{item}}
    </view>
  </view>

  <view class="diagnostic-banner-slot" wx:if="{{diagnosticBannerEnabled}}">
    <ad unit-id="{{diagnosticBannerAdUnitId}}" ad-type="banner" binderror="onDiagnosticBannerError"></ad>
  </view>

  <view class="waterfall" wx:if="{{isLoading && leftList.length === 0 && rightList.length === 0}}">
    <view class="waterfall-col">
      <view class="card skeleton-card" wx:for="{{[1, 2]}}" wx:key="*this">
        <view class="card-image-wrap skeleton-img-box skeleton-shimmer" style="aspect-ratio: {{index % 2 === 0 ? '4/5' : '1/1'}}; height: auto;"></view>
        <view class="card-content">
          <view class="card-title skeleton-text-line skeleton-shimmer"></view>
          <view class="card-footer">
            <view class="card-cost skeleton-text-short skeleton-shimmer"></view>
          </view>
        </view>
      </view>
    </view>
    <view class="waterfall-col">
      <view class="card skeleton-card" wx:for="{{[1, 2]}}" wx:key="*this">
        <view class="card-image-wrap skeleton-img-box skeleton-shimmer" style="aspect-ratio: {{index % 2 === 0 ? '1/1' : '4/5'}}; height: auto;"></view>
        <view class="card-content">
          <view class="card-title skeleton-text-line skeleton-shimmer"></view>
          <view class="card-footer">
            <view class="card-cost skeleton-text-short skeleton-shimmer"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="waterfall" wx:else>
    <view class="waterfall-col">
      <view class="card js-feature-card" wx:for="{{leftList}}" wx:key="_id" bindtap="goToFeature" data-id="{{item._id}}" data-name="{{item.name}}" data-group="{{currentGroup}}" data-position="{{item.homeIndex + 1}}">
        <view class="card-image-wrap {{item.image.loaded ? '' : 'skeleton-shimmer skeleton-bg'}}" style="{{item.image.loaded ? '' : 'aspect-ratio: 4/5;'}}">
          <view class="card-badge hot" wx:if="{{item.tag === 'hot'}}">HOT</view>
          <view class="card-badge new" wx:if="{{item.tag === 'new'}}">NEW</view>
          <image wx:if="{{!item.image.error}}" class="card-image fade-in {{item.image.loaded ? 'visible' : ''}}" mode="widthFix" src="{{item.image.displayUrl || 'https://dummyimage.com/400x500.png/F5F5F7/AAAAAA?text=Banner'}}" lazy-load bindload="onImageLoad" binderror="onImageError" data-id="{{item._id}}" data-col="left"></image>
          <view wx:else class="card-image-fallback">图片暂时无法显示</view>
        </view>
        <view class="card-content">
          <view class="card-title">{{item.name}}</view>
          <view class="card-rating-stats" aria-label="模板评价：夯 {{item.hang_count || 0}}，拉 {{item.la_count || 0}}">
            <view class="rating-stat-item">
              <text class="stat-icon">👍</text>
              <text class="stat-count">{{item.hang_count || 0}}</text>
            </view>
            <view class="rating-stat-item ml-20">
              <text class="stat-icon">👎</text>
              <text class="stat-count">{{item.la_count || 0}}</text>
            </view>
          </view>
          <view class="card-footer">
            <view class="card-cost" wx:if="{{item.points_cost > 0}}">
              <text class="cost-icon">✦</text>{{item.points_cost}} 星光
            </view>
            <view class="card-cost free" wx:else>限免</view>
            <view class="card-btn">立即使用</view>
          </view>
        </view>
      </view>
    </view>
    <view class="waterfall-col">
      <view class="card js-feature-card" wx:for="{{rightList}}" wx:key="_id" bindtap="goToFeature" data-id="{{item._id}}" data-name="{{item.name}}" data-group="{{currentGroup}}" data-position="{{item.homeIndex + 1}}">
        <view class="card-image-wrap {{item.image.loaded ? '' : 'skeleton-shimmer skeleton-bg'}}" style="{{item.image.loaded ? '' : 'aspect-ratio: 4/5;'}}">
          <view class="card-badge hot" wx:if="{{item.tag === 'hot'}}">HOT</view>
          <view class="card-badge new" wx:if="{{item.tag === 'new'}}">NEW</view>
          <image wx:if="{{!item.image.error}}" class="card-image fade-in {{item.image.loaded ? 'visible' : ''}}" mode="widthFix" src="{{item.image.displayUrl || 'https://dummyimage.com/400x500.png/F5F5F7/AAAAAA?text=Banner'}}" lazy-load bindload="onImageLoad" binderror="onImageError" data-id="{{item._id}}" data-col="right"></image>
          <view wx:else class="card-image-fallback">图片暂时无法显示</view>
        </view>
        <view class="card-content">
          <view class="card-title">{{item.name}}</view>
          <view class="card-rating-stats" aria-label="模板评价：夯 {{item.hang_count || 0}}，拉 {{item.la_count || 0}}">
            <view class="rating-stat-item">
              <text class="stat-icon">👍</text>
              <text class="stat-count">{{item.hang_count || 0}}</text>
            </view>
            <view class="rating-stat-item ml-20">
              <text class="stat-icon">👎</text>
              <text class="stat-count">{{item.la_count || 0}}</text>
            </view>
          </view>
          <view class="card-footer">
            <view class="card-cost" wx:if="{{item.points_cost > 0}}">
              <text class="cost-icon">✦</text>{{item.points_cost}} 星光
            </view>
            <view class="card-cost free" wx:else>限免</view>
            <view class="card-btn">立即使用</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{isLoading && (leftList.length > 0 || rightList.length > 0)}}">
    <view class="spinner"></view>
  </view>
  <view class="empty" wx:if="{{!isLoading && leftList.length === 0 && rightList.length === 0}}">
    暂无生图模板，敬请期待
  </view>
</view>

<reward-modal visible="{{newUserGiftModalVisible}}" variant="gift"></reward-modal>
